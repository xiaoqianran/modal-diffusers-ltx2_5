HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MODEL_ID=Lightricks/LTX-2.5-Diffusers
MODEL_REVISION=69009ff070135c693ad1ad1ef2cc149c227963da
QUANTIZED_MODEL_DIR=LTX-2.5-Diffusers-bnb-4bit
OFFLOAD_MODE=model
OUTPUT_DIR=outputs
INPUT_DIR=inputs
MAX_UPLOAD_SIZE_MB=500
MAX_QUEUE_SIZE=4
# OpenAI-compatible external LLM for the optional prompt rewrite button.
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=60
# Set to 1 only after the first successful download if the server has no network.
HF_HUB_OFFLINE=0
# --- Acceleration (2026-09) ---
# Transformer precision: nf4 (default) / fp8 (48GB-class) / bf16 (96GB-class) /
# nvfp4 (sm_120 Blackwell only, fastest; official FP4 distilled checkpoint)
# LTX25_TRANSFORMER_PRECISION=nvfp4
# CUDA Graph capture of the transformer forward (bit-identical, requires OFFLOAD_MODE=none)
# LTX25_CUDA_GRAPH=1
# LTX25_CUDA_GRAPH_MAX_CAPTURES=8
# Video encoder: nvenc (default) / x264. p4 preset recommended for realtime.
# LTX25_VIDEO_ENCODER=nvenc
# LTX25_NVENC_PRESET=p4
# Modal deployment / local router.
# The default path is now: local FastAPI router -> Modal SDK -> RTX PRO 6000 Worker.
# Keep-warm is lease-based and OFF until Studio explicitly acquires a lease.
LTX25_LOCAL_KEEP_GPU_WARM=0
# Studio renews this lease every 30s; abandoned tabs therefore release the GPU
# automatically instead of letting the Router keep it alive forever.
LTX25_WARM_LEASE_SECONDS=90
# Worker idle window while a lease or active job exists.
# LTX25_MODAL_GPU_IDLE_SECONDS=600
# Load Gemma and the NVFP4 transformer concurrently during cold start.
# LTX25_PARALLEL_COLD_LOAD=1
# Compatibility only: deploy the old remote CPU ASGI gateway when explicitly enabled.
# LTX25_MODAL_REMOTE_GATEWAY=0

# --- Media data plane ---
# Zero-config development path.
LTX25_MEDIA_BACKEND=volume

# Routed production storage. Store IDs are stable opaque identifiers persisted
# with asset/output metadata; changing which store is primary later does not
# invalidate historical objects.
# LTX25_MEDIA_PRIMARY_ID=r2
# LTX25_MEDIA_PRIMARY_BACKEND=s3
# LTX25_MEDIA_PRIMARY_S3_BUCKET=ltx25-media-r2
# LTX25_MEDIA_PRIMARY_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# LTX25_MEDIA_PRIMARY_S3_REGION=auto
# LTX25_MEDIA_PRIMARY_S3_ACCESS_KEY_ID=
# LTX25_MEDIA_PRIMARY_S3_SECRET_ACCESS_KEY=
#
# LTX25_MEDIA_FALLBACK_ID=minio
# LTX25_MEDIA_FALLBACK_BACKEND=s3
# LTX25_MEDIA_FALLBACK_S3_BUCKET=ltx25-media
# LTX25_MEDIA_FALLBACK_S3_ENDPOINT_URL=https://minio.example.com
# LTX25_MEDIA_FALLBACK_S3_REGION=us-east-1
# LTX25_MEDIA_FALLBACK_S3_ACCESS_KEY_ID=
# LTX25_MEDIA_FALLBACK_S3_SECRET_ACCESS_KEY=
#
# Browser upload behavior: retry the selected store first; if transfer still
# fails, request a fresh fallback upload session. Multipart ETags are never
# reused across stores.
# LTX25_MEDIA_PRESIGN_SECONDS=3600
# <24 MiB stays a single PUT. 24 MiB+ uses adaptive multipart plans:
# 40-64 MiB -> ~8 MiB parts / 2-way; 64-256 MiB -> ~16 MiB / 4-way;
# 256 MiB+ -> >=32 MiB / 6-way.
# LTX25_MEDIA_MULTIPART_THRESHOLD_MB=24
# LTX25_MEDIA_PART_SIZE_MB=16
# After repeated primary data-plane failures, temporarily route new writes
# directly to fallback instead of paying the failed R2 retries every time.
# LTX25_MEDIA_BREAKER_FAILURES=3
# LTX25_MEDIA_BREAKER_COOLDOWN_SECONDS=60
#
# GPU input staging: prefetch small objects to local /tmp in parallel; keep
# larger primary objects on read-only CloudBucketMount.
# LTX25_INPUT_PREFETCH_MB=32
# LTX25_INPUT_PREFETCH_WORKERS=4
#
# Worker secret: AWS_* aliases are the primary credentials used by
# CloudBucketMount; the prefixed variables are consumed by MediaStorage.
# LTX25_MODAL_MEDIA_SECRET=media-storage
# Secret keys:
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# LTX25_MEDIA_PRIMARY_S3_ACCESS_KEY_ID
# LTX25_MEDIA_PRIMARY_S3_SECRET_ACCESS_KEY
# LTX25_MEDIA_FALLBACK_S3_ACCESS_KEY_ID
# LTX25_MEDIA_FALLBACK_S3_SECRET_ACCESS_KEY

# Legacy single-S3 configuration remains supported for compatibility:
# LTX25_MEDIA_BACKEND=s3
# LTX25_S3_BUCKET=ltx25-media
# LTX25_S3_ENDPOINT_URL=https://minio.example.com
# LTX25_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
